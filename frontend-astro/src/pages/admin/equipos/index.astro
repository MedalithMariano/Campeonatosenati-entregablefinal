---
import Layout from "@/layouts/Layout.astro";
import Field from "@/components/Field.astro";
import Alert from "@/components/Alert.astro";
import { Plus, Pencil, Trash2 } from "@lucide/astro";
---

<Layout title="Admin · Equipos">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-indigo-600">Administración</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
          Equipos
        </h1>
      </div>
      <button
        type="button"
        id="toggle-form"
        class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-700"
      >
        <Plus size={16} />
        Nuevo equipo
      </button>
    </header>

    <section
      id="form-section"
      hidden
      class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <div class="border-b border-slate-100 px-6 py-4">
        <h2 class="text-base font-semibold text-slate-900">Crear equipo</h2>
      </div>
      <form id="create-form" class="space-y-5 px-6 py-5" novalidate>
        <Alert id="create-error" />

        <Field id="name" label="Nombre" required />

        <div class="grid grid-cols-2 gap-3">
          <Field id="shortName" label="Abreviatura" placeholder="Ej. RMA" />
          <Field id="city" label="Ciudad" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <Field id="foundedYear" label="Año de fundación" type="number" placeholder="1903" />
          <Field id="primaryColor" label="Color principal" type="color" />
        </div>

        <div class="space-y-1.5">
          <label for="logo" class="block text-sm font-medium text-slate-700">
            Escudo <span class="text-slate-400 font-normal">· opcional</span>
          </label>
          <input
            id="logo"
            name="logo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-slate-700"
          />
          <p class="text-xs text-slate-500">JPEG, PNG o WebP · máx 5MB</p>
        </div>

        <div class="flex items-center justify-end gap-2">
          <button
            type="button"
            id="cancel-btn"
            class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-indigo-400"
          >
            Crear
          </button>
        </div>
      </form>
    </section>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500"
    >
      Cargando…
    </section>

    <ul
      id="list"
      hidden
      class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm divide-y divide-slate-100"
    >
    </ul>
  </main>
</Layout>

<script>
  import {
    api,
    auth,
    ApiError,
    cloudinaryUrl,
    type Team,
    type CreateTeamPayload,
  } from "@/lib/api";

  const token = auth.requireAdmin();
  if (!token) {
    // requireAdmin redirected
  } else {
    const loading = document.getElementById("loading") as HTMLElement;
    const list = document.getElementById("list") as HTMLUListElement;
    const toggleBtn = document.getElementById("toggle-form") as HTMLButtonElement;
    const formSection = document.getElementById("form-section") as HTMLElement;
    const form = document.getElementById("create-form") as HTMLFormElement;
    const errorBox = document.getElementById("create-error") as HTMLElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const cancelBtn = document.getElementById("cancel-btn") as HTMLButtonElement;

    function showError(messages: string[]) {
      errorBox.replaceChildren(
        ...messages.map((m) => {
          const d = document.createElement("div");
          d.textContent = m;
          return d;
        }),
      );
      errorBox.hidden = false;
    }
    function clearError() {
      errorBox.hidden = true;
      errorBox.replaceChildren();
    }

    function renderRow(team: Team): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "flex items-center gap-4 px-5 py-4";

      const logoBox = document.createElement("div");
      logoBox.className =
        "flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-slate-100 text-xs font-semibold text-slate-500";
      const logo = cloudinaryUrl(team.logoUrl, "w_80,h_80,c_fill,q_auto,f_auto");
      if (logo) {
        const img = document.createElement("img");
        img.src = logo;
        img.alt = team.name;
        img.className = "h-full w-full object-cover";
        logoBox.appendChild(img);
      } else {
        logoBox.textContent = team.name[0]?.toUpperCase() ?? "?";
      }

      const meta = document.createElement("div");
      meta.className = "min-w-0 flex-1";
      const name = document.createElement("p");
      name.className = "truncate font-medium text-slate-900";
      name.textContent = team.name;
      const sub = document.createElement("p");
      sub.className = "truncate text-xs text-slate-500";
      sub.textContent = [team.shortName, team.city].filter(Boolean).join(" · ");
      meta.append(name, sub);

      const editLink = document.createElement("a");
      editLink.href = `/admin/equipos/editar?id=${encodeURIComponent(team.id)}`;
      editLink.className =
        "inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50";
      editLink.innerHTML = "";
      const editIcon = document.createElement("span");
      editIcon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
      const editText = document.createElement("span");
      editText.textContent = "Editar";
      editLink.append(editIcon, editText);

      const delBtn = document.createElement("button");
      delBtn.type = "button";
      delBtn.className =
        "inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-50";
      const delIcon = document.createElement("span");
      delIcon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>';
      const delText = document.createElement("span");
      delText.textContent = "Eliminar";
      delBtn.append(delIcon, delText);
      delBtn.addEventListener("click", async () => {
        if (!confirm(`¿Eliminar el equipo "${team.name}"?`)) return;
        try {
          await api.deleteTeam(token, team.id);
          await refresh();
        } catch (err) {
          alert(
            err instanceof ApiError ? err.messages.join(" · ") : "Error",
          );
        }
      });

      const actions = document.createElement("div");
      actions.className = "flex items-center gap-2";
      actions.append(editLink, delBtn);

      li.append(logoBox, meta, actions);
      return li;
    }

    async function refresh() {
      loading.hidden = false;
      list.hidden = true;
      try {
        const teams = await api.listTeams();
        loading.hidden = true;
        list.replaceChildren(...teams.map(renderRow));
        list.hidden = false;
      } catch (err) {
        loading.textContent =
          err instanceof ApiError ? err.messages.join(" · ") : "Error al cargar";
      }
    }

    toggleBtn.addEventListener("click", () => {
      formSection.hidden = !formSection.hidden;
      clearError();
      if (!formSection.hidden) form.reset();
    });
    cancelBtn.addEventListener("click", () => {
      formSection.hidden = true;
      form.reset();
      clearError();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearError();
      const fd = new FormData(form);
      const file = (fd.get("logo") as File | null) ?? null;

      const payload: CreateTeamPayload = {
        name: String(fd.get("name") ?? "").trim(),
        shortName: String(fd.get("shortName") ?? "").trim() || undefined,
        city: String(fd.get("city") ?? "").trim() || undefined,
        foundedYear: Number(fd.get("foundedYear")) || undefined,
        primaryColor: String(fd.get("primaryColor") ?? "").trim() || undefined,
      };

      submitBtn.disabled = true;
      submitBtn.textContent = "Creando…";

      try {
        if (file && file.size > 0) {
          submitBtn.textContent = "Subiendo escudo…";
          const upload = await api.uploadImage(token, file, "teams");
          payload.logoUrl = upload.url;
          payload.logoPublicId = upload.publicId;
        }
        submitBtn.textContent = "Guardando…";
        await api.createTeam(token, payload);
        formSection.hidden = true;
        form.reset();
        await refresh();
      } catch (err) {
        showError(
          err instanceof ApiError ? err.messages : ["Error inesperado"],
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Crear";
      }
    });

    await refresh();
  }
</script>
