---
import Layout from "@/layouts/Layout.astro";
import { Shield, Users as UsersIcon } from "@lucide/astro";
---

<Layout title="Admin">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header>
      <p class="text-sm font-medium text-indigo-600">Administración</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
        Panel
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Gestión de catálogo del campeonato.
      </p>
    </header>

    <section
      id="content"
      hidden
      class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2"
    >
      <a
        href="/admin/equipos"
        class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700">
          <Shield size={22} />
        </span>
        <div>
          <p class="font-semibold text-slate-900">Equipos</p>
          <p class="text-sm text-slate-500">Crear, editar y eliminar equipos.</p>
        </div>
      </a>

      <a
        href="/admin/jugadores"
        class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
          <UsersIcon size={22} />
        </span>
        <div>
          <p class="font-semibold text-slate-900">Jugadores</p>
          <p class="text-sm text-slate-500">Catálogo de jugadores con foto y documento.</p>
        </div>
      </a>
    </section>
  </main>
</Layout>

<script>
  import { auth } from "@/lib/api";

  const token = auth.requireAdmin();
  if (token) {
    document.getElementById("content")!.hidden = false;
  }
</script>
