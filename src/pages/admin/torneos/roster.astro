---
import Layout from "@/layouts/Layout.astro";
import Alert from "@/components/Alert.astro";
---

<Layout title="Admin · Roster">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <a id="back-link" href="/admin/torneos" class="text-sm text-slate-500 hover:text-slate-700">
      ← Volver a inscripciones
    </a>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500"
    >
      Cargando…
    </section>

    <section id="content" hidden class="mt-8 space-y-6">
      <header class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="px-6 py-5">
          <p class="text-sm font-medium text-indigo-600">Roster</p>
          <h1 id="title" class="mt-1 text-xl font-semibold text-slate-900"></h1>
          <p id="subtitle" class="text-xs text-slate-500"></p>
          <div
            id="validation"
            class="mt-3 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium"
          ></div>
        </div>
      </header>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
          <h2 class="text-base font-semibold text-slate-900">Añadir jugador</h2>
        </div>
        <form id="add-form" class="grid grid-cols-1 gap-3 px-6 py-5 sm:grid-cols-[1fr_120px_auto]" novalidate>
          <Alert id="add-error" />

          <div class="space-y-1.5 sm:col-span-1">
            <label for="player-select" class="block text-sm font-medium text-slate-700">
              Jugador
            </label>
            <select
              id="player-select"
              class="block w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-100"
            >
              <option value="">— elige un jugador —</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="shirt-input" class="block text-sm font-medium text-slate-700">
              Dorsal
            </label>
            <input
              id="shirt-input"
              type="number"
              min="1"
              max="99"
              class="block w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-xs focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-100"
            />
          </div>

          <div class="flex items-end">
            <button
              type="submit"
              id="add-btn"
              class="inline-flex h-[42px] w-full items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-indigo-400 sm:w-auto"
            >
              Añadir
            </button>
          </div>
        </form>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
          <h2 class="text-base font-semibold text-slate-900">Plantilla</h2>
        </div>
        <ul id="roster-list" class="divide-y divide-slate-100"></ul>
      </section>
    </section>
  </main>
</Layout>

<script>
  import {
    api,
    auth,
    ApiError,
    cloudinaryUrl,
    type Player,
    type RosterEntry,
    type RosterValidation,
  } from "@/lib/api";

  const POSITION_LABEL: Record<Player["position"], string> = {
    GK: "Portero",
    DEF: "Defensa",
    MID: "Centrocampista",
    FWD: "Delantero",
  };

  const token = auth.requireAdmin();
  const params = new URLSearchParams(window.location.search);
  const tournamentId = params.get("id");
  const teamId = params.get("teamId");

  const loading = document.getElementById("loading") as HTMLElement;
  const content = document.getElementById("content") as HTMLElement;

  if (!token || !tournamentId || !teamId) {
    if (!tournamentId || !teamId)
      loading.textContent = "Faltan parámetros (id y teamId)";
  } else {
    const backLink = document.getElementById("back-link") as HTMLAnchorElement;
    backLink.href = `/admin/torneos/inscripciones?id=${encodeURIComponent(tournamentId)}`;

    const playerSelect = document.getElementById("player-select") as HTMLSelectElement;
    const shirtInput = document.getElementById("shirt-input") as HTMLInputElement;
    const addForm = document.getElementById("add-form") as HTMLFormElement;
    const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
    const addError = document.getElementById("add-error") as HTMLElement;
    const rosterList = document.getElementById("roster-list") as HTMLUListElement;
    const validationBox = document.getElementById("validation") as HTMLElement;

    let allPlayers: Player[] = [];
    let roster: RosterEntry[] = [];

    function setMessages(el: HTMLElement, messages: string[]) {
      el.replaceChildren(
        ...messages.map((m) => {
          const d = document.createElement("div");
          d.textContent = m;
          return d;
        }),
      );
      el.hidden = false;
    }
    function clearMessages(el: HTMLElement) {
      el.hidden = true;
      el.replaceChildren();
    }

    function updateSelect() {
      const rosteredIds = new Set(roster.map((r) => r.playerId));
      const available = allPlayers.filter((p) => !rosteredIds.has(p.id));

      playerSelect.replaceChildren(
        ...[
          (() => {
            const o = document.createElement("option");
            o.value = "";
            o.textContent =
              available.length === 0
                ? "— no hay jugadores disponibles —"
                : "— elige un jugador —";
            return o;
          })(),
          ...available.map((p) => {
            const o = document.createElement("option");
            o.value = p.id;
            o.textContent = `${p.firstName} ${p.lastName} (${POSITION_LABEL[p.position]})`;
            return o;
          }),
        ],
      );
      addBtn.disabled = available.length === 0;
    }

    function paintValidation(v: RosterValidation) {
      validationBox.textContent = `${v.count} jugadores · Mínimo ${v.min} · Máximo ${v.max}`;
      if (v.belowMin) {
        validationBox.className =
          "mt-3 inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800";
      } else if (v.aboveMax) {
        validationBox.className =
          "mt-3 inline-flex items-center rounded-full bg-rose-100 px-3 py-1 text-xs font-medium text-rose-700";
      } else {
        validationBox.className =
          "mt-3 inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-700";
      }
    }

    function renderRow(entry: RosterEntry): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "flex items-center gap-4 px-5 py-4";

      const player = entry.player;

      const shirt = document.createElement("div");
      shirt.className =
        "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-sm font-bold text-indigo-700";
      shirt.textContent = String(entry.shirtNumber);

      const avatar = document.createElement("div");
      avatar.className =
        "flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-xs font-semibold text-slate-500";
      const photo = cloudinaryUrl(
        player?.photoUrl ?? null,
        "w_80,h_80,c_fill,g_face,q_auto,f_auto",
      );
      if (photo) {
        const img = document.createElement("img");
        img.src = photo;
        img.alt = player ? `${player.firstName} ${player.lastName}` : "";
        img.className = "h-full w-full object-cover";
        avatar.appendChild(img);
      } else if (player) {
        avatar.textContent =
          `${player.firstName[0] ?? ""}${player.lastName[0] ?? ""}`.toUpperCase();
      } else {
        avatar.textContent = "?";
      }

      const meta = document.createElement("div");
      meta.className = "min-w-0 flex-1";
      const name = document.createElement("p");
      name.className = "truncate font-medium text-slate-900";
      name.textContent = player
        ? `${player.firstName} ${player.lastName}`
        : entry.playerId;
      const sub = document.createElement("p");
      sub.className = "truncate text-xs text-slate-500";
      sub.textContent = player ? POSITION_LABEL[player.position] : "";
      meta.append(name, sub);

      const editBtn = document.createElement("button");
      editBtn.type = "button";
      editBtn.className =
        "inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50";
      editBtn.textContent = "Cambiar dorsal";
      editBtn.addEventListener("click", async () => {
        const value = prompt("Nuevo dorsal (1-99):", String(entry.shirtNumber));
        if (value === null) return;
        const next = Number(value);
        if (!Number.isInteger(next) || next < 1 || next > 99) {
          alert("Dorsal inválido (1-99)");
          return;
        }
        try {
          await api.updateRosterEntry(
            token,
            tournamentId!,
            teamId!,
            entry.playerId,
            next,
          );
          await refresh();
        } catch (err) {
          alert(err instanceof ApiError ? err.messages.join(" · ") : "Error");
        }
      });

      const delBtn = document.createElement("button");
      delBtn.type = "button";
      delBtn.className =
        "inline-flex items-center rounded-lg border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-50";
      delBtn.textContent = "Quitar";
      delBtn.addEventListener("click", async () => {
        if (!confirm("¿Quitar este jugador del roster?")) return;
        try {
          await api.removeRosterEntry(
            token,
            tournamentId!,
            teamId!,
            entry.playerId,
          );
          await refresh();
        } catch (err) {
          alert(err instanceof ApiError ? err.messages.join(" · ") : "Error");
        }
      });

      const actions = document.createElement("div");
      actions.className = "flex items-center gap-2";
      actions.append(editBtn, delBtn);

      li.append(shirt, avatar, meta, actions);
      return li;
    }

    async function refresh() {
      const [r, v] = await Promise.all([
        api.listRoster(tournamentId!, teamId!),
        api.validateRoster(tournamentId!, teamId!),
      ]);
      roster = r;

      if (roster.length === 0) {
        const li = document.createElement("li");
        li.className = "px-5 py-6 text-center text-sm text-slate-500";
        li.textContent = "Aún no hay jugadores en el roster.";
        rosterList.replaceChildren(li);
      } else {
        rosterList.replaceChildren(...roster.map(renderRow));
      }

      paintValidation(v);
      updateSelect();
    }

    try {
      const [tournament, team, players, registrations] = await Promise.all([
        api.getTournament(tournamentId),
        api.getTeam(teamId),
        api.listPlayers(),
        api.listRegistrations(tournamentId),
      ]);

      const isRegistered = registrations.some((r) => r.teamId === teamId);
      if (!isRegistered) {
        loading.textContent =
          "El equipo no está inscrito en este torneo. Inscríbelo primero.";
      } else {
        allPlayers = players;

        document.getElementById("title")!.textContent = team.name;
        document.getElementById("subtitle")!.textContent =
          `${tournament.name} · Temporada ${tournament.season}`;

        await refresh();

        loading.hidden = true;
        content.hidden = false;

        addForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearMessages(addError);
          const playerId = playerSelect.value;
          const shirt = Number(shirtInput.value);
          if (!playerId) {
            setMessages(addError, ["Elige un jugador"]);
            return;
          }
          if (!Number.isInteger(shirt) || shirt < 1 || shirt > 99) {
            setMessages(addError, ["Dorsal inválido (1-99)"]);
            return;
          }

          addBtn.disabled = true;
          addBtn.textContent = "Añadiendo…";
          try {
            await api.addRosterEntry(token, tournamentId, teamId, {
              playerId,
              shirtNumber: shirt,
            });
            shirtInput.value = "";
            await refresh();
          } catch (err) {
            setMessages(
              addError,
              err instanceof ApiError ? err.messages : ["Error inesperado"],
            );
          } finally {
            addBtn.disabled = false;
            addBtn.textContent = "Añadir";
          }
        });
      }
    } catch (err) {
      loading.textContent =
        err instanceof ApiError ? err.messages.join(" · ") : "Error";
    }
  }
</script>
