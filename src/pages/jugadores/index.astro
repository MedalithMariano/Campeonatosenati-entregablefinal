---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Nuevo Jugador">
  <main class="mx-auto max-w-2xl px-6 py-10">
    <a href="/jugadores" class="text-sm text-slate-500 hover:text-slate-700">
      ← Volver a jugadores
    </a>

    <div class="mt-6">
      <p class="text-sm font-medium text-indigo-600">Jugadores</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
        Nuevo jugador
      </h1>
    </div>

    <div id="error-box" hidden class="mt-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>

    <form id="form" class="mt-8 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

      <!-- Foto -->
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2">Foto del jugador</label>
        <div class="flex items-center gap-4">
          <div
            id="photo-preview"
            class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-slate-400 text-xs text-center"
          >
            Sin foto
          </div>
          <div>
            <label
              for="photo-input"
              class="cursor-pointer inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50"
            >
              📁 Seleccionar imagen
            </label>
            <input id="photo-input" type="file" accept="image/*" class="hidden" />
            <p class="mt-1 text-xs text-slate-400">PNG, JPG o WEBP. Máx 5 MB.</p>
            <p id="upload-status" class="mt-1 text-xs text-indigo-600 hidden">Subiendo imagen…</p>
          </div>
        </div>
      </div>

      <hr class="border-slate-100" />

      <!-- Nombres -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="first-name" class="block text-sm font-medium text-slate-700">
            Nombres <span class="text-red-500">*</span>
          </label>
          <input
            id="first-name"
            type="text"
            required
            placeholder="Ej: Carlos"
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </div>
        <div>
          <label for="last-name" class="block text-sm font-medium text-slate-700">
            Apellidos <span class="text-red-500">*</span>
          </label>
          <input
            id="last-name"
            type="text"
            required
            placeholder="Ej: Ramírez"
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </div>
      </div>

      <!-- Documento -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="doc-type" class="block text-sm font-medium text-slate-700">
            Tipo de documento <span class="text-red-500">*</span>
          </label>
          <select
            id="doc-type"
            required
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          >
            <option value="DNI">DNI</option>
            <option value="CE">CE</option>
            <option value="PASAPORTE">Pasaporte</option>
            <option value="RUC">RUC</option>
          </select>
        </div>
        <div>
          <label for="doc-number" class="block text-sm font-medium text-slate-700">
            Número de documento <span class="text-red-500">*</span>
          </label>
          <input
            id="doc-number"
            type="text"
            required
            placeholder="Ej: 12345678"
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </div>
      </div>

      <!-- Fecha de nacimiento y nacionalidad -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="birth-date" class="block text-sm font-medium text-slate-700">
            Fecha de nacimiento <span class="text-red-500">*</span>
          </label>
          <input
            id="birth-date"
            type="date"
            required
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </div>
        <div>
          <label for="nationality" class="block text-sm font-medium text-slate-700">
            Nacionalidad
          </label>
          <input
            id="nationality"
            type="text"
            placeholder="Ej: Peruana"
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          />
        </div>
      </div>

      <!-- Posición y pie preferido -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="position" class="block text-sm font-medium text-slate-700">
            Posición <span class="text-red-500">*</span>
          </label>
          <select
            id="position"
            required
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          >
            <option value="GK">🧤 Portero (GK)</option>
            <option value="DEF">🛡️ Defensa (DEF)</option>
            <option value="MID">⚙️ Mediocampista (MID)</option>
            <option value="FWD">⚡ Delantero (FWD)</option>
          </select>
        </div>
        <div>
          <label for="preferred-foot" class="block text-sm font-medium text-slate-700">
            Pie preferido
          </label>
          <select
            id="preferred-foot"
            class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          >
            <option value="">— Sin especificar —</option>
            <option value="RIGHT">Derecho</option>
            <option value="LEFT">Izquierdo</option>
            <option value="BOTH">Ambidiestro</option>
          </select>
        </div>
      </div>

      <!-- Botones -->
      <div class="flex items-center justify-end gap-3 pt-2">
        <a
          href="/jugadores"
          class="rounded-xl border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50"
        >
          Cancelar
        </a>
        <button
          id="submit-btn"
          type="submit"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
        >
          Guardar jugador
        </button>
      </div>
    </form>
  </main>
</Layout>

<script>
  import { api, ApiError, auth } from "@/lib/api";

  const token = auth.requireAdmin();
  if (!token) throw new Error("No autorizado");

  const form = document.getElementById("form") as HTMLFormElement;
  const errorBox = document.getElementById("error-box") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const photoInput = document.getElementById("photo-input") as HTMLInputElement;
  const photoPreview = document.getElementById("photo-preview") as HTMLElement;
  const uploadStatus = document.getElementById("upload-status") as HTMLElement;

  let uploadedPhotoUrl: string | null = null;
  let uploadedPhotoPublicId: string | null = null;

  // Preview y subida de foto
  photoInput.addEventListener("change", async () => {
    const file = photoInput.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      photoPreview.innerHTML = `<img src="${e.target?.result}" class="h-full w-full object-cover rounded-full" />`;
    };
    reader.readAsDataURL(file);

    uploadStatus.hidden = false;
    uploadStatus.textContent = "Subiendo imagen…";
    uploadStatus.className = "mt-1 text-xs text-indigo-600";
    try {
      const uploaded = await api.uploadImage(token!, file, "players");
      uploadedPhotoUrl = uploaded.url;
      uploadedPhotoPublicId = uploaded.publicId;
      uploadStatus.textContent = "✓ Imagen subida";
      uploadStatus.className = "mt-1 text-xs text-green-600";
    } catch {
      uploadStatus.textContent = "Error al subir imagen";
      uploadStatus.className = "mt-1 text-xs text-red-600";
    }
  });

  // Submit
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.hidden = true;

    const firstName = (document.getElementById("first-name") as HTMLInputElement).value.trim();
    const lastName = (document.getElementById("last-name") as HTMLInputElement).value.trim();
    const documentType = (document.getElementById("doc-type") as HTMLSelectElement).value as any;
    const documentNumber = (document.getElementById("doc-number") as HTMLInputElement).value.trim();
    const birthDate = (document.getElementById("birth-date") as HTMLInputElement).value;
    const position = (document.getElementById("position") as HTMLSelectElement).value as any;
    const preferredFoot = (document.getElementById("preferred-foot") as HTMLSelectElement).value as any;
    const nationality = (document.getElementById("nationality") as HTMLInputElement).value.trim();

    if (!firstName || !lastName || !documentNumber || !birthDate) {
      errorBox.textContent = "Por favor completa todos los campos obligatorios.";
      errorBox.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Guardando…";

    try {
      await api.createPlayer(token!, {
        firstName,
        lastName,
        documentType,
        documentNumber,
        birthDate,
        position,
        preferredFoot: preferredFoot || undefined,
        nationality: nationality || undefined,
        photoUrl: uploadedPhotoUrl ?? undefined,
        photoPublicId: uploadedPhotoPublicId ?? undefined,
      });

      window.location.href = "/jugadores";
    } catch (err) {
      errorBox.textContent =
        err instanceof ApiError ? err.messages.join(" · ") : "Error al guardar";
      errorBox.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Guardar jugador";
    }
  });
</script>