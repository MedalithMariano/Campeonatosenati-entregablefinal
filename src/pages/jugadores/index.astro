---
import Layout from "../../layouts/Layout.astro";
import { Users as UsersIcon } from "@lucide/astro";
---

<Layout title="Jugadores">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header>
      <p class="text-sm font-medium text-indigo-600">Catálogo</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
        Jugadores
      </h1>
    </header>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500"
    >
      Cargando jugadores…
    </section>

    <section
      id="empty"
      hidden
      class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center"
    >
      <UsersIcon size={28} class="mx-auto text-slate-400" />
      <p class="mt-3 text-sm text-slate-500">
        Todavía no hay jugadores registrados.
      </p>
    </section>

    <ul
      id="list"
      hidden
      class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm divide-y divide-slate-100"
    >
    </ul>
  </main>
</Layout>

<script>
  import { api, ApiError, cloudinaryUrl, type Player } from "../../lib/api";

  const POSITION_LABEL: Record<Player["position"], string> = {
    GK: "Portero",
    DEF: "Defensa",
    MID: "Centrocampista",
    FWD: "Delantero",
  };

  const loading = document.getElementById("loading") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const list = document.getElementById("list") as HTMLUListElement;

  function initials(first: string, last: string): string {
    return `${first[0] ?? ""}${last[0] ?? ""}`.toUpperCase();
  }

  function renderRow(p: Player): HTMLLIElement {
    const li = document.createElement("li");
    const link = document.createElement("a");
    link.href = `/jugadores/ver?id=${encodeURIComponent(p.id)}`;
    link.className =
      "flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50";

    const avatar = document.createElement("div");
    avatar.className =
      "flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-sm font-semibold text-slate-500";

    const photo = cloudinaryUrl(p.photoUrl, "w_120,h_120,c_fill,g_face,q_auto,f_auto");
    if (photo) {
      const img = document.createElement("img");
      img.src = photo;
      img.alt = `${p.firstName} ${p.lastName}`;
      img.className = "h-full w-full object-cover";
      img.loading = "lazy";
      avatar.appendChild(img);
    } else {
      avatar.textContent = initials(p.firstName, p.lastName);
    }

    const info = document.createElement("div");
    info.className = "min-w-0";
    const name = document.createElement("p");
    name.className = "truncate font-medium text-slate-900";
    name.textContent = `${p.firstName} ${p.lastName}`;
    const meta = document.createElement("p");
    meta.className = "truncate text-xs text-slate-500";
    meta.textContent = [POSITION_LABEL[p.position], p.nationality]
      .filter(Boolean)
      .join(" · ");
    info.append(name, meta);

    link.append(avatar, info);
    li.appendChild(link);
    return li;
  }

  try {
    const players = await api.listPlayers();
    loading.hidden = true;

    if (players.length === 0) {
      empty.hidden = false;
    } else {
      list.replaceChildren(...players.map(renderRow));
      list.hidden = false;
    }
  } catch (err) {
    loading.textContent =
      err instanceof ApiError ? err.messages.join(" · ") : "Error al cargar";
  }
</script>
