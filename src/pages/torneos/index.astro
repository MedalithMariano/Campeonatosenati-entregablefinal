---
import Layout from "@/layouts/Layout.astro";
import { Trophy } from "@lucide/astro";
---

<Layout title="Torneos">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header>
      <p class="text-sm font-medium text-indigo-600">Campeonato</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
        Torneos
      </h1>
    </header>

    <section
      id="loading"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500"
    >
      Cargando torneos…
    </section>

    <section
      id="empty"
      hidden
      class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center"
    >
      <Trophy size={28} class="mx-auto text-slate-400" />
      <p class="mt-3 text-sm text-slate-500">
        Todavía no hay torneos publicados.
      </p>
    </section>

    <ul
      id="grid"
      hidden
      class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    >
    </ul>
  </main>
</Layout>

<script>
  import { api, ApiError, cloudinaryUrl, type Tournament } from "@/lib/api";

  const FORMAT_LABEL: Record<Tournament["format"], string> = {
    LEAGUE: "Liga",
    KNOCKOUT: "Eliminatoria",
    GROUPS_KNOCKOUT: "Grupos + Eliminatoria",
  };

  const STATUS_LABEL: Record<Tournament["status"], string> = {
    DRAFT: "Borrador",
    REGISTRATION: "Inscripciones abiertas",
    IN_PROGRESS: "En curso",
    FINISHED: "Finalizado",
  };

  const STATUS_COLOR: Record<Tournament["status"], string> = {
    DRAFT: "bg-slate-100 text-slate-600",
    REGISTRATION: "bg-emerald-100 text-emerald-700",
    IN_PROGRESS: "bg-indigo-100 text-indigo-700",
    FINISHED: "bg-slate-100 text-slate-500",
  };

  const loading = document.getElementById("loading") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const grid = document.getElementById("grid") as HTMLUListElement;

  function renderCard(t: Tournament): HTMLLIElement {
    const li = document.createElement("li");
    li.className =
      "overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md";

    const link = document.createElement("a");
    link.href = `/torneos/ver?id=${encodeURIComponent(t.id)}`;
    link.className = "block";

    const banner = document.createElement("div");
    banner.className = "h-32 w-full bg-gradient-to-br from-indigo-500 to-indigo-700";
    const bannerUrl = cloudinaryUrl(
      t.bannerUrl,
      "w_600,h_240,c_fill,q_auto,f_auto",
    );
    if (bannerUrl) {
      banner.style.backgroundImage = `url(${bannerUrl})`;
      banner.style.backgroundSize = "cover";
      banner.style.backgroundPosition = "center";
    }

    const body = document.createElement("div");
    body.className = "p-5";

    const badge = document.createElement("span");
    badge.className = `inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${STATUS_COLOR[t.status]}`;
    badge.textContent = STATUS_LABEL[t.status];

    const name = document.createElement("h2");
    name.className = "mt-3 truncate text-lg font-semibold text-slate-900";
    name.textContent = t.name;

    const meta = document.createElement("p");
    meta.className = "mt-1 text-xs text-slate-500";
    meta.textContent = `${FORMAT_LABEL[t.format]} · Temporada ${t.season}`;

    body.append(badge, name, meta);
    link.append(banner, body);
    li.appendChild(link);
    return li;
  }

  try {
    const tournaments = await api.listTournaments();
    loading.hidden = true;

    if (tournaments.length === 0) {
      empty.hidden = false;
    } else {
      grid.replaceChildren(...tournaments.map(renderCard));
      grid.hidden = false;
    }
  } catch (err) {
    loading.textContent =
      err instanceof ApiError ? err.messages.join(" · ") : "Error al cargar";
  }
</script>
